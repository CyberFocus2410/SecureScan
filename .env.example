# ==============================================================================
# SecureScan AI - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# Never commit actual secret values to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="SecureScan AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite default for local development, PostgreSQL for production)
# Example PostgreSQL: postgresql://user:password@localhost:5432/securescan
DATABASE_URL="sqlite:///./securescan_dev.db"

# Redis & RQ Worker Configuration
REDIS_URL="redis://localhost:6379/0"
RQ_QUEUE_NAME="securescan_audits"

# Security & CORS (Comma-separated or JSON list of trusted frontend origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
SECURITY_HEADERS_ENABLED=true

# Rate Limiting (Requests per minute per IP / Session)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Webhook Secrets (For external GitHub/CI integrations)
WEBHOOK_SECRET="change-this-to-a-secure-random-hmac-key"

# AI Remediation Assistance (Optional P1 Feature)
# Leave empty to utilize deterministic offline remediation templates
GEMINI_API_KEY=""
AI_EXPLAIN_ENABLED=false

# Regulatory Baseline
AS_OF_DATE="2026-11-14"
