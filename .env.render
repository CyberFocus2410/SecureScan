# ==============================================================================
# SecureScan AI — Render Backend Environment Configuration
# Paste directly into: Render Dashboard -> Your Service -> Environment -> "Add from .env"
# ==============================================================================

# Core Application Settings
PYTHON_VERSION=3.11.9
PIP_PREFER_BINARY=1
CARGO_HOME=/tmp/.cargo
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="SecureScan AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
AS_OF_DATE="2026-11-14"

# Database Configuration
# In Render: Create a "PostgreSQL" database and paste its "Internal Database URL" here.
# Default SQLite is provided for instant zero-dependency testing.
DATABASE_URL=sqlite:///./securescan_dev.db

# Redis & Queue Configuration
# In Render: Create a "Redis" instance and paste its "Internal Redis URL" here.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=securescan_audits

# CORS (Allows your Vercel frontend to communicate with this Render backend)
CORS_ORIGINS=["https://secure-scan-two.vercel.app","http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$
SECURITY_HEADERS_ENABLED=true

# Rate Limiting (120 requests per minute per IP / Session)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Cryptographic Webhook Signing Secret
WEBHOOK_SECRET=5baca5ee09972a678c7892417697d8cdd2af66b98b8b8c2c1b807f46dab124be

# Optional Gemini API Key for contextual tips (Leave empty for deterministic rules)
GEMINI_API_KEY=
AI_EXPLAIN_ENABLED=false
